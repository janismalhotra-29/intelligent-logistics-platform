# ==============================================================================
# NER Smart Logistics Intelligence Platform - Environment Configuration Example
# Copy this file to .env and configure values before starting the application.
# NEVER commit the real .env or secrets to Git!
# ==============================================================================

# Environment profile: 'development', 'production', or 'test'
ENVIRONMENT=development
DEBUG=false

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL with PostGIS or SQLite for standalone demo)
# For local Docker PostGIS: postgresql://ner_admin:YOUR_STRONG_PASSWORD@db:5432/ner_logistics
# For managed cloud DB (Render, Supabase, Neon): postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=sqlite:///./data/ner_platform.db
POSTGRES_DB=ner_logistics
POSTGRES_USER=ner_admin
POSTGRES_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_HERE

# Security & API Keys
# Change these in production!
ADMIN_API_KEY=replace-with-a-random-32-char-admin-token
SECRET_KEY=replace-with-a-random-64-char-secret-key

# Allowed CORS Origins (Comma-separated list of allowed frontend URLs)
# In production, set to your actual frontend domain (e.g. https://ner-logistics.vercel.app)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Frontend Environment Variables (Set in frontend/.env when building or hosting on Vercel)
# VITE_API_BASE_URL=https://your-backend-api.onrender.com/api
# VITE_WS_URL=wss://your-backend-api.onrender.com/ws/live
